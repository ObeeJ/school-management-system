# Railway Environment Configuration Template
PORT=4000
NODE_ENV=production

# Database (Railway Postgres Plugin or External Managed Instance)
DATABASE_URL=postgresql://postgres:password@containers-us-west-1.railway.app:5432/railway

# Redis Cache (Railway Redis Plugin)
REDIS_URL=redis://default:password@redis.railway.internal:6379

# Frontend Public API URL
NEXT_PUBLIC_API_URL=https://scholaria-backend-production.up.railway.app
